{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "compilerOptions": {
    "strict": true
  },
  "tasks": {
    "run": "deno run --allow-net --allow-write --allow-env --allow-read backend/src/search_properties.ts",
    "validate": "deno run --allow-net --allow-write --allow-env --allow-read backend/src/validate_properties.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "worker": "deno run --allow-net --allow-env --allow-read backend/src/worker.ts",
    "test": "deno test -A tests/"
  },
  "imports": {
    "cheerio": "npm:cheerio@^1.1.2",
    "@std/async": "jsr:@std/async@^1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.119.0",
    "resend": "npm:resend@^4",
    "postgres": "npm:postgres@4.1.1"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "exclude": [
    "frontend/node_modules",
    "frontend/dist",
    "frontend/test-results",
    "frontend/playwright-report"
  ]
}
