[Unit]
Description=House Validator - Valida anúncios de imóveis salvos
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@RUN_USER@
WorkingDirectory="@BACKEND_DIR@"
Environment="DENO_BIN=@DENO_BIN@"
ExecStart=/bin/bash "@EXEC_BACKEND_DIR@/scripts/run-house-validator.sh"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
