[Unit]
Description=House Crawler request worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory="@BACKEND_DIR@"
Environment="DENO_BIN=@DENO_BIN@"
ExecStart=/bin/bash "@EXEC_BACKEND_DIR@/scripts/run-house-worker.sh"
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
